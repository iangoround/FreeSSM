	$(QINSTALL) C:\Qt\5.15.2\mingw81_32\plugins\platforms\qwindows.dll C:$(INSTALL_ROOT:@msyshack@%=%)\FreeSSM\platforms\qwindows.dll

uninstall_platformstarget: FORCE
	-$(DEL_FILE) C:$(INSTALL_ROOT:@msyshack@%=%)\FreeSSM\platforms\qwindows.dll
	-$(DEL_DIR) C:$(INSTALL_ROOT:@msyshack@%=%)\FreeSSM\platforms 


install: install_target install_doctarget install_defstarget install_filestarget install_translation install_dllstarget install_platformstarget  FORCE

uninstall: uninstall_target uninstall_doctarget uninstall_defstarget uninstall_filestarget uninstall_translation uninstall_dllstarget uninstall_platformstarget  FORCE

FORCE:

