install_target: first FORCE
	@if not exist C:$(INSTALL_ROOT:@msyshack@%=%)\FreeSSM mkdir C:$(INSTALL_ROOT:@msyshack@%=%)\FreeSSM & if not exist C:$(INSTALL_ROOT:@msyshack@%=%)\FreeSSM exit 1
	-$(INSTALL_FILE) $(DESTDIR_TARGET) C:$(INSTALL_ROOT:@msyshack@%=%)\FreeSSM\$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) C:$(INSTALL_ROOT:@msyshack@%=%)\FreeSSM\$(TARGET)
	-$(DEL_DIR) C:$(INSTALL_ROOT:@msyshack@%=%)\FreeSSM 


