release/FreeSSM_WinAppIcon_res.o: ../resources/FreeSSM_WinAppIcon.rc
	windres -i ..\resources\FreeSSM_WinAppIcon.rc -o release\FreeSSM_WinAppIcon_res.o --include-dir=./../resources $(DEFINES)

